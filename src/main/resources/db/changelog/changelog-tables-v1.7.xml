<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="stoevand" id="37">
        <addColumn tableName="bet_history">
            <column name="pp_bet"  type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="t3_bet"  type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="dpp_bet" type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="pp_win"  type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="t3_win"  type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="dpp_win" type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="stoevand" id="38">
        <addColumn tableName="played_games">
            <column name="initial_player_cards"  type="VARCHAR(255)"/>
            <column name="initial_dealer_cards"  type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet author="stoevand" id="39">
        <addColumn tableName="wallets">
            <column name="last_pp_bet"  type="NUMERIC" defaultValueNumeric="0.00"/>
            <column name="last_t3_bet"  type="NUMERIC" defaultValueNumeric="0.00"/>
            <column name="last_dpp_bet" type="NUMERIC" defaultValueNumeric="0.00"/>
        </addColumn>
    </changeSet>

    <changeSet author="stoevand" id="40">
        <addColumn tableName="wallets">
            <column name="last_hand_win" type="NUMERIC" defaultValueNumeric="0.00"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
