<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Per-category last-win tracking for the win breakdown display -->
    <changeSet author="stoevand" id="35">
        <addColumn tableName="wallets">
            <column name="last_pp_win" type="DECIMAL(38,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="last_t3_win" type="DECIMAL(38,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="last_dpp_win" type="DECIMAL(38,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
