<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Add NOT NULL + DEFAULT 0 to wallet monetary columns that were originally created nullable -->
    <changeSet author="stoevand" id="28">
        <addNotNullConstraint tableName="wallets" columnName="balance"
                              columnDataType="DECIMAL(38,2)" defaultNullValue="0.00"/>
        <addNotNullConstraint tableName="wallets" columnName="current_bet"
                              columnDataType="DECIMAL(38,2)" defaultNullValue="0.00"/>
        <addNotNullConstraint tableName="wallets" columnName="hand_bet"
                              columnDataType="DECIMAL(38,2)" defaultNullValue="0.00"/>
        <addNotNullConstraint tableName="wallets" columnName="double_bet"
                              columnDataType="DECIMAL(38,2)" defaultNullValue="0.00"/>
        <addNotNullConstraint tableName="wallets" columnName="insurance_bet"
                              columnDataType="DECIMAL(38,2)" defaultNullValue="0.00"/>
        <addNotNullConstraint tableName="wallets" columnName="last_bet"
                              columnDataType="DECIMAL(38,2)" defaultNullValue="0.00"/>
        <addNotNullConstraint tableName="wallets" columnName="last_win"
                              columnDataType="DECIMAL(38,2)" defaultNullValue="0.00"/>
    </changeSet>

</databaseChangeLog>
