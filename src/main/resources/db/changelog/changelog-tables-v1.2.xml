<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- NOT NULL constraints on existing wallet columns are expressed as column definitions
         in changelog-tables-v1.0.xml; SQLite cannot ALTER TABLE ADD CONSTRAINT, so these
         changesets are preserved as no-ops to keep the Liquibase checksum history intact. -->
    <changeSet author="stoevand" id="28"><sql>SELECT 1</sql></changeSet>

    <changeSet author="stoevand" id="29">
        <addColumn tableName="bet_history">
            <column name="split" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="stoevand" id="30">
        <addColumn tableName="played_games">
            <column name="split_hands" type="TEXT"/>
            <column name="split_hand_multipliers" type="VARCHAR(1023)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
