<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="stoevand" id="1">
        <createTable tableName="activation_tokens">
            <column autoIncrement="true" name="id" type="INTEGER">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_at" type="datetime"/>
            <column name="token" type="VARCHAR(255)"/>
            <column name="user_id" type="INTEGER">
                <constraints unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="stoevand" id="2">
        <createTable tableName="bet_history">
            <column autoIncrement="true" name="id" type="INTEGER">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="return_amount" type="NUMERIC">
                <constraints nullable="false"/>
            </column>
            <column name="total_bet_amount" type="NUMERIC">
                <constraints nullable="false"/>
            </column>
            <column name="double_down" type="BOOLEAN"/>
            <column name="split" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="game_hash" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
            <column name="user_id" type="INTEGER"/>
            <column name="pp_bet"  type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="t3_bet"  type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="dpp_bet" type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="pp_win"  type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="t3_win"  type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="dpp_win" type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="stoevand" id="3">
        <createTable tableName="credit_cards">
            <column autoIncrement="true" name="id" type="INTEGER">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="card_cvc" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="card_holder" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="card_number" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="expired_month" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="expired_year" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="stoevand" id="4">
        <createTable tableName="last_games">
            <column autoIncrement="true" name="id" type="INTEGER">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="available_choices" type="VARCHAR(255)"/>
            <column name="dealer_cards" type="VARCHAR(255)"/>
            <column name="dealer_second_card" type="VARCHAR(63)"/>
            <column name="dealt_time" type="datetime"/>
            <column name="err_code_list" type="VARCHAR(255)"/>
            <column name="finalized" type="BOOLEAN"/>
            <column name="hand_multiplier" type="DOUBLE"/>
            <column name="hash" type="VARCHAR(255)"/>
            <column name="insurance" type="BOOLEAN"/>
            <column name="double_down" type="BOOLEAN"/>
            <column name="insurance_multiplier" type="DOUBLE"/>
            <column name="player_cards" type="VARCHAR(255)"/>
            <column name="taken_choices" type="VARCHAR(255)"/>
            <column name="owner_id" type="INTEGER">
                <constraints unique="true"/>
            </column>
            <column name="split_hands" type="TEXT"/>
            <column name="split_hand_multipliers" type="VARCHAR(1023)"/>
            <column name="split_double_down_flags" type="VARCHAR(255)"/>
            <column name="split_active" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="active_split_hand_index" type="INT" defaultValueNumeric="0"/>
            <column name="split_count" type="INT" defaultValueNumeric="0"/>
            <column name="split_aces" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="initial_player_cards" type="VARCHAR(255)"/>
            <column name="initial_dealer_up_card" type="VARCHAR(255)"/>
            <column name="initial_dealer_cards" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet author="stoevand" id="5">
        <createTable tableName="played_games">
            <column autoIncrement="true" name="id" type="INTEGER">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="dealer_cards" type="VARCHAR(255)"/>
            <column name="dealt_time" type="datetime"/>
            <column name="finalized_time" type="datetime"/>
            <column name="hand_multiplier" type="DOUBLE"/>
            <column name="hash" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="insurance" type="BOOLEAN"/>
            <column name="double_down" type="BOOLEAN"/>
            <column name="insurance_multiplier" type="DOUBLE"/>
            <column name="player_cards" type="VARCHAR(255)"/>
            <column name="taken_choices" type="VARCHAR(255)"/>
            <column name="owner_id" type="INTEGER"/>
            <column name="split_hands" type="TEXT"/>
            <column name="split_hand_multipliers" type="VARCHAR(1023)"/>
            <column name="initial_player_cards" type="VARCHAR(255)"/>
            <column name="initial_dealer_cards" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet author="stoevand" id="6">
        <createTable tableName="reset_pass_tokens">
            <column autoIncrement="true" name="id" type="INTEGER">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="created_at" type="datetime"/>
            <column name="token" type="VARCHAR(255)"/>
            <column name="user_id" type="INTEGER">
                <constraints unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="stoevand" id="7">
        <createTable tableName="roles">
            <column autoIncrement="true" name="id" type="INTEGER">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="role" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="stoevand" id="8">
        <createTable tableName="users">
            <column autoIncrement="true" name="id" type="INTEGER">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="birth_date" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="gender" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="my_wallet_id" type="INTEGER">
                <constraints unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="stoevand" id="9">
        <createTable tableName="users_roles">
            <column name="user_id" type="INTEGER">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="role_id" type="INTEGER">
                <constraints nullable="false" primaryKey="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="stoevand" id="10">
        <createTable tableName="wallets">
            <column autoIncrement="true" name="id" type="INTEGER">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="balance" type="NUMERIC"/>
            <column name="current_bet" type="NUMERIC"/>
            <column name="hand_bet" type="NUMERIC"/>
            <column name="double_bet" type="NUMERIC"/>
            <column name="insurance_bet" type="NUMERIC"/>
            <column name="last_bet" type="NUMERIC"/>
            <column name="last_win" type="NUMERIC"/>
            <column name="split_bet" type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="perfect_pairs_bet" type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="twenty_one_three_bet" type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="dealer_perfect_pairs_bet" type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="last_pp_win" type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="last_t3_win" type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="last_dpp_win" type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="last_total_bet" type="NUMERIC" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="last_pp_bet" type="NUMERIC" defaultValueNumeric="0.00"/>
            <column name="last_t3_bet" type="NUMERIC" defaultValueNumeric="0.00"/>
            <column name="last_dpp_bet" type="NUMERIC" defaultValueNumeric="0.00"/>
            <column name="last_hand_win" type="NUMERIC" defaultValueNumeric="0.00"/>
            <column name="owner_id" type="INTEGER">
                <constraints unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="stoevand" id="11">
        <createIndex associatedWith="" indexName="FK2ycif7hrrfm42c8vbt5mhk6do" tableName="credit_cards">
            <column name="owner_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="stoevand" id="12">
        <createIndex associatedWith="" indexName="FKdmcpuojdom24p10ql69t7u1lt" tableName="bet_history">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="stoevand" id="13">
        <createIndex associatedWith="" indexName="FKge83d5ruenla5b6d8rkt3y368" tableName="played_games">
            <column name="owner_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="stoevand" id="14">
        <createIndex associatedWith="" indexName="FKj6m8fwv7oqv74fcehir1a9ffy" tableName="users_roles">
            <column name="role_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="stoevand" id="15">
        <addColumn tableName="last_games">
            <column name="split_hand_taken_choices" type="TEXT"/>
        </addColumn>
        <addColumn tableName="played_games">
            <column name="split_hand_taken_choices" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet author="stoevand" id="16">
        <addColumn tableName="bet_history">
            <column name="hand_bet" type="NUMERIC" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
