    <!-- Give admin user a wallet -->
    <changeSet author="andy489" id="data-v1.2-3">
        <insert tableName="wallets">
            <column name="id" valueNumeric="2"/>
            <column name="balance" valueNumeric="1000.00"/>
            <column name="current_bet" valueNumeric="0.00"/>
            <column name="last_bet" valueNumeric="0.00"/>
            <column name="last_win" valueNumeric="0.00"/>
            <column name="hand_bet" valueNumeric="0.00"/>
            <column name="double_bet" valueNumeric="0.00"/>
            <column name="insurance_bet" valueNumeric="0.00"/>
            <column name="owner_id" valueNumeric="6"/>
        </insert>
    </changeSet>

    <!-- Fix NULLs in admin wallet on existing DBs where data-v1.2-3 ran without defaults -->
    <changeSet author="andy489" id="data-v1.2-4">
        <update tableName="wallets">
            <column name="split_bet" valueNumeric="0.00"/>
            <column name="perfect_pairs_bet" valueNumeric="0.00"/>
            <column name="twenty_one_three_bet" valueNumeric="0.00"/>
            <column name="dealer_perfect_pairs_bet" valueNumeric="0.00"/>
            <column name="last_pp_win" valueNumeric="0.00"/>
            <column name="last_t3_win" valueNumeric="0.00"/>
            <column name="last_dpp_win" valueNumeric="0.00"/>
            <column name="last_total_bet" valueNumeric="0.00"/>
            <column name="last_pp_bet" valueNumeric="0.00"/>
            <column name="last_t3_bet" valueNumeric="0.00"/>
            <column name="last_dpp_bet" valueNumeric="0.00"/>
            <column name="last_hand_win" valueNumeric="0.00"/>
            <where>owner_id = 6 AND (split_bet IS NULL OR perfect_pairs_bet IS NULL)</where>
        </update>
    </changeSet>
    <!-- Fix admin birth_date from datetime string to epoch millis (matching JPA java.util.Date storage format) -->
    <changeSet author="andy489" id="data-v1.2-5">
        <update tableName="users">
            <column name="birth_date" value="631141200000"/>
            <where>id = 6 AND birth_date = '1990-01-01 00:00:00'</where>
        </update>
    </changeSet>

</databaseChangeLog>
