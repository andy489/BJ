    <!-- Give admin user the ADMIN role -->
    <changeSet author="andy489" id="data-v1.2-2">
        <insert tableName="users_roles">
            <column name="user_id" valueNumeric="6"/>
            <column name="role_id" valueNumeric="1"/>
